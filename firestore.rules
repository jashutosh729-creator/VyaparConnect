rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['retailer', 'manufacturer']
        && request.resource.data.approvalStatus == 'pending';
      allow update: if (isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.approvalStatus == resource.data.approvalStatus)
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.manufacturerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manufacturer';
      allow update, delete: if signedIn()
        && resource.data.manufacturerId == request.auth.uid
        && request.resource.data.manufacturerId == resource.data.manufacturerId;
    }

    match /carts/{userId}/items/{productId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.retailerId == request.auth.uid
          || resource.data.manufacturerId == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.retailerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && resource.data.manufacturerId == request.auth.uid
        && request.resource.data.retailerId == resource.data.retailerId
        && request.resource.data.manufacturerId == resource.data.manufacturerId;
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && resource.data.type == 'negotiation'
          && resource.data.senderId != request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text == resource.data.text;
        allow delete: if false;
      }
    }

    match /negotiations/{negotiationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }
  }
}
